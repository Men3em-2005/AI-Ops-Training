// Sales & Inventory Management System — data model
// SQLite has no native enum support, so role/status fields are plain
// String columns; the allowed values are enforced in app/lib/types.ts.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Branch {
  id       String @id @default(cuid())
  name     String
  location String
  active   Boolean @default(true)

  users            User[]
  stock            Stock[]
  purchaseOrders   PurchaseOrder[]
  transfersOut     StockTransfer[]     @relation("TransferFrom")
  transfersIn      StockTransfer[]     @relation("TransferTo")
  sales            Sale[]
  stockMovements   StockMovement[]

  createdAt DateTime @default(now())
}

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String
  role         String // ADMIN | MANAGER | STAFF
  branchId     String?
  branch       Branch? @relation(fields: [branchId], references: [id])
  active       Boolean @default(true)

  purchaseOrdersCreated PurchaseOrder[]
  transfersRequested    StockTransfer[]
  sales                 Sale[]

  createdAt DateTime @default(now())
}

model Category {
  id   String @id @default(cuid())
  name String @unique

  products Product[]
}

model Product {
  id              String   @id @default(cuid())
  name            String
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  unitPrice       Float
  unitOfMeasure   String
  defaultMinStock Int      @default(10)
  active          Boolean  @default(true)

  stock              Stock[]
  purchaseOrderItems PurchaseOrderItem[]
  stockTransferItems StockTransferItem[]
  saleItems          SaleItem[]
  stockMovements     StockMovement[]

  createdAt DateTime @default(now())

  @@index([name])
}

model Supplier {
  id            String  @id @default(cuid())
  name          String
  contactPerson String
  phone         String
  active        Boolean @default(true)

  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  status      String   @default("DRAFT") // DRAFT | SENT | PARTIALLY_RECEIVED | RECEIVED | CANCELLED
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  expectedDate DateTime?

  items PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseOrderItem {
  id          String        @id @default(cuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  orderedQty  Int
  receivedQty Int           @default(0)
  unitCost    Float
}

model Stock {
  id        String  @id @default(cuid())
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(0)
  minStock  Int     @default(10)

  @@unique([branchId, productId])
}

model StockMovement {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  type        String // SALE | PURCHASE_RECEIPT | TRANSFER_IN | TRANSFER_OUT | ADJUSTMENT
  quantity    Int // positive = stock in, negative = stock out
  referenceId String? // id of the Sale / PurchaseOrder / StockTransfer that caused this
  createdAt   DateTime @default(now())

  @@index([branchId, productId])
  @@index([type])
}

model StockTransfer {
  id            String   @id @default(cuid())
  fromBranchId  String
  fromBranch    Branch   @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId    String
  toBranch      Branch   @relation("TransferTo", fields: [toBranchId], references: [id])
  status        String   @default("REQUESTED") // REQUESTED | IN_TRANSIT | COMPLETED | CANCELLED
  requestedById String
  requestedBy   User     @relation(fields: [requestedById], references: [id])

  items StockTransferItem[]

  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

model StockTransferItem {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Int
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  createdAt DateTime @default(now())

  sales Sale[]
}

model Sale {
  id           String    @id @default(cuid())
  branchId     String
  branch       Branch    @relation(fields: [branchId], references: [id])
  employeeId   String
  employee     User      @relation(fields: [employeeId], references: [id])
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  status       String    @default("COMPLETED") // COMPLETED | CANCELLED | REFUNDED
  discount         Float     @default(0)
  subtotal         Float
  total            Float
  resolutionReason String? // reason for CANCELLED or REFUNDED status

  items SaleItem[]

  createdAt DateTime @default(now())
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  lineTotal Float
}
